# Local development configuration. Copy to `.env` (which is git-ignored):
#   cp .env.example .env
# These credentials match the local development container described in the
# README. They are for development only; never put real secrets here.

# Database used by the app and by `alembic` commands.
DATABASE_URL=postgresql+psycopg://repair_shop:repair_shop@localhost:5433/repair_shop

# Separate database used by the test suite. Its schema is dropped and
# recreated on every test run, so the name must end in `_test`.
TEST_DATABASE_URL=postgresql+psycopg://repair_shop:repair_shop@localhost:5433/repair_shop_test

# Browser origins allowed to call the API (CORS), comma-separated, exact
# origins only (scheme://host[:port], no trailing slash). Empty or unset means
# no cross-origin browser access. "*" is rejected.
# CORS_ORIGINS=http://localhost:3000
